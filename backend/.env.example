# Copy to .env and fill in local values. Never commit a filled .env.
#
# Required to run the API: DATABASE_URL
# Optional for local browsing: CORS_ORIGINS, RATE_LIMIT_*, API_KEYS
# Optional, ingest CLI only: CONNECTOR_NCBI_API_KEY, CONNECTOR_NCBI_EMAIL

PROJECT_NAME=BIOWIKI API
API_VERSION=0.1.0
BIOWIKI_ENV=development

# Local PostgreSQL (replace USER/PASSWORD before any public deploy).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/biowiki
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Comma-separated browser origins. Production should list only the real site.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Empty = open API (local development). Set comma-separated keys for production.
API_KEYS=

# Production (Render / Railway): also set BIOWIKI_ENV=production,
# DATABASE_SSL=true, CORS_ORIGINS to the public UI origin, and optionally
# CORS_ORIGIN_REGEX=https://.*\\.vercel\\.app
# BOOTSTRAP_SEED=auto imports curated real accessions when the catalogue is empty.

# Optional NCBI E-utilities identity (raises the allowed request rate).
# Leave blank unless you have a key from https://www.ncbi.nlm.nih.gov/account/
CONNECTOR_NCBI_API_KEY=
CONNECTOR_NCBI_EMAIL=
