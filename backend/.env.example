# Copy to .env and fill in local values. Never commit a filled .env.

PROJECT_NAME=BIOWIKI API
API_VERSION=0.1.0
BIOWIKI_ENV=development

# Local PostgreSQL (replace USER/PASSWORD before any public deploy).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/biowiki
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Comma-separated browser origins. Production should list only the real site.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Empty = open API (local development). Set comma-separated keys for production.
API_KEYS=

# Optional NCBI E-utilities identity (raises the allowed request rate).
# Leave blank unless you have a key from https://www.ncbi.nlm.nih.gov/account/
CONNECTOR_NCBI_API_KEY=
CONNECTOR_NCBI_EMAIL=
