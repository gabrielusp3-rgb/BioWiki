# Copy to .env and fill in local values. Never commit a filled .env.
#
# Required to run the API: DATABASE_URL
# Optional for local browsing: CORS_ORIGINS, RATE_LIMIT_*, API_KEYS
# Optional, ingest CLI only: CONNECTOR_NCBI_API_KEY, CONNECTOR_NCBI_EMAIL

PROJECT_NAME=BIOWIKI API
API_VERSION=0.1.0
BIOWIKI_ENV=development

# Local PostgreSQL (replace USER/PASSWORD before any public deploy).
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@localhost:5432/biowiki
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Comma-separated browser origins. Production must list only the public site,
# never localhost. Local development uses the value below.
CORS_ORIGINS=http://localhost:3000

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Empty = open read-only API (current public production). Set comma-separated
# keys only if catalogue routes must require X-API-Key. Never commit real keys.
API_KEYS=

# Production (Vercel): BIOWIKI_ENV=production, DATABASE_SSL=true,
# CORS_ORIGINS=https://biowiki-nine.vercel.app (the live UI only).
# Do not set CORS_ORIGIN_REGEX to a wildcard such as *.vercel.app.
# BOOTSTRAP_SEED=auto imports curated real accessions when the catalogue is empty.
# Schema changes: run `alembic upgrade head` as an operator from a laptop or
# CI job. Never run Alembic inside the Vercel function lifespan.

# Optional NCBI E-utilities identity (raises the allowed request rate).
# Leave blank unless you have a key from https://www.ncbi.nlm.nih.gov/account/
CONNECTOR_NCBI_API_KEY=
CONNECTOR_NCBI_EMAIL=
